load("@gazelle//:def.bzl", "gazelle", "gazelle_binary")

# gazelle:prefix github.com/andyscott/gazelle_fold
gazelle_binary(
    name = "gazelle_fold",
    languages = [
        "//language/policy",
        "@gazelle//language/go",
    ],
    visibility = ["//visibility:public"],
)

gazelle(
    name = "gazelle",
    command = "fix",
    gazelle = ":gazelle_fold",
)

gazelle(
    name = "gazelle_ci",
    command = "fix",
    extra_args = ["-mode=diff"],
    gazelle = ":gazelle_fold",
)
