# gazelle:fold import("policy.star")
# gazelle:fold use("no_handwritten_generated_deps", scope = "...", kinds = ["rust_library"], deny = ["@cargo//..."], allowed_calls = ["all_crate_deps"])

load("@cargo//:defs.bzl", "all_crate_deps")

rust_library(
    name = "generated_deps",
    deps = all_crate_deps(cargo_only = True),
)

rust_library(
    name = "mixed_deps",
    deps = [
        ":local",
        "@cargo//:serde",
    ] + all_crate_deps(cargo_only = True),
)

rust_library(
    name = "select_deps",
    deps = select({
        "//conditions:default": [],
        "//conditions:wasm": ["@cargo//:wasm-bindgen"],
    }, no_match_error = "unsupported platform"),
)

rust_library(
    name = "opaque_deps",
    deps = SOME_DEPS,
)
